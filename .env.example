# Supabase — fight-zone project
# Copy to .env.local and fill in your real values. NEVER commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<your-key>
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Update V3: server-only email automation -------------------------------
# Service-role key: used ONLY by server-side trusted email infrastructure
# (scheduled jobs + cancellation alerts) that has no user session. Never
# expose this to the browser (must NOT be prefixed NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=service_role_<your-key>

# Shared secret that protects the cron API routes. Must match the value set
# as an environment variable on the scheduler (Netlify) and in this app.
CRON_SECRET=<generate-a-long-random-string>

# Resend sender identity for event automation (Update V3). The existing
# Resend sender used by other Fight Zone emails uses RESEND_FROM_EMAIL too.
RESEND_FROM_EMAIL=Fight Zone <noreply@fight-zone.app>
RESEND_REPLY_TO_EMAIL=

# --- Update V4: Daily AI Motivational Coach (Gemini, server-only) ------------
# Optional. Without these, the app serves the curated fallback library.
# Server-only: NEVER prefix with NEXT_PUBLIC_. Must also be set on Netlify
# for production. See lib/ai/README.md.
AI_MOTIVATION_ENABLED=true
GEMINI_API_KEY=AIza<your-google-ai-studio-key>
# Optional overrides (defaults shown):
GEMINI_MODEL=gemini-3.5-flash
AI_MOTIVATION_TIMEOUT_MS=8000
